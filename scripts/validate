#!/usr/bin/env sh
set -eu

export PYTHONDONTWRITEBYTECODE=1

scripts/test

python3 -m cli.main --home /tmp/orchestra-validate init \
  --linear-project-slug validate-project \
  --target-repo https://github.com/example/repo.git \
  --force >/dev/null

python3 -m cli.main --home /tmp/orchestra-validate show paths >/dev/null
python3 -m cli.main --home /tmp/orchestra-validate show workflow >/dev/null
python3 -m cli.main github pr-feedback wait --help >/dev/null
python3 -m cli.main github reviewers ensure --help >/dev/null
python3 -m cli.main pr-feedback wait --help >/dev/null
python3 -m cli.main trace event --help >/dev/null
python3 -m cli --help >/dev/null
sh -n scripts/install
test -x scripts/install-orchestra
test -x scripts/install

test -f AGENTS.md
test -f ARCHITECTURE.md
test -f docs/index.md
test -f docs/decisions/0003-honor-linear-blockers-before-dispatch.md
test -d docs/archive
